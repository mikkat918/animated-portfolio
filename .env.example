# Server only. Copy to .env and fill in your OmniRoute account details.
# Use the API base URL from your OmniRoute dashboard/docs; the server appends /chat/completions.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
PORT=5173
GITHUB_USERNAME=mikkat918
# Automatic project refresh/cache lifetime (60 seconds to 24 hours; default 15 minutes).
GITHUB_CACHE_TTL_MS=900000
